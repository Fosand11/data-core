# Production template for compose.prod.yaml. Copy it to `.env.production` ON THE
# SERVER and fill in the blanks. The real file is git-ignored: never commit it.
#
#   docker compose --env-file .env.production -f compose.prod.yaml <command>
#
# Generate each secret with:  openssl rand -hex 24

APP_NAME="InsightFlow"
APP_ENV=production
# Generate with: docker compose --env-file .env.production -f compose.prod.yaml run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.example.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
# Host name only (no scheme). Caddy obtains the HTTPS certificate for it.
APP_DOMAIN=demo.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=saas-db
DB_PORT=5432
DB_DATABASE=insightflow
DB_USERNAME=insightflow
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=insightflow
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=240

# No mail server in the demo: messages are written to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TENANCY_SEED_DEMO_DATA=true

# Account created by `php artisan demo:install` (password: at least 12 characters).
DEMO_USER_NAME=Demo
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Public demo on Gemini's free tier. Keep the limits low: they protect the quota.
DASHBOARD_AI_DRIVER=gemini
DASHBOARD_AI_STALE_AFTER_MINUTES=10
DASHBOARD_AI_RATE_LIMIT_PER_MINUTE=2
DASHBOARD_AI_RATE_LIMIT_PER_HOUR=10
# Shared by every user: caps what the whole demo can spend of the free quota per day.
DASHBOARD_AI_GLOBAL_PER_DAY=60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=16384

# Docker Compose
COMPOSE_PROJECT_NAME=insightflow
# Bump it on every release so images are rebuilt and can be rolled back.
APP_IMAGE_TAG=1
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# Explicit image versions, never `latest` (same values as .env.example).
PHP_IMAGE=php:8.4.11-fpm-bookworm
COMPOSER_IMAGE=composer:2.8.12
NODE_IMAGE=node:22.12.0-bookworm-slim
CADDY_IMAGE=caddy:2.10.2-alpine
POSTGRES_IMAGE=postgres:17.6-alpine
REDIS_IMAGE=redis:8.2.1-alpine
