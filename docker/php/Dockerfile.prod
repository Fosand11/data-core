# Production image. Unlike docker/php/Dockerfile (development, code mounted from
# the host), this one bakes the application and its compiled assets in.
#
# Targets:
#   app     php-fpm with the application (also runs the queue worker)
#   web     Caddy: automatic HTTPS, serves public/ and forwards PHP to app
#   render  everything in ONE container, for single-container hosts (see the last stage)
#
# compose.prod.yaml always names its targets. A build without --target (what a PaaS
# does) ends at the last stage, `render`.
#
# Every base image comes from build args (see .env.example); the defaults below are
# the same pinned versions, and none uses `latest`.
ARG PHP_IMAGE=php:8.4.11-fpm-bookworm
ARG COMPOSER_IMAGE=composer:2.8.12
ARG NODE_IMAGE=node:22.12.0-bookworm-slim
ARG CADDY_IMAGE=caddy:2.10.2-alpine

FROM ${COMPOSER_IMAGE} AS composer

# --- PHP base: extensions the application needs --------------------------------
FROM ${PHP_IMAGE} AS base

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libicu-dev \
        libpq-dev \
        libzip-dev \
        unzip \
    && docker-php-ext-install -j"$(nproc)" bcmath intl opcache pcntl pdo_pgsql zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

COPY --from=composer /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1

WORKDIR /var/www/html

# --- Composer dependencies, without dev packages -----------------------------------
FROM base AS vendor

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --no-autoloader

# --- Frontend build ----------------------------------------------------------------
# resources/js/app.ts imports Ziggy from vendor/, so the PHP dependencies come first.
FROM ${NODE_IMAGE} AS assets

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
# pnpm at the exact version pinned in package.json ("packageManager"). Corepack is
# avoided on purpose: the one bundled with this Node cannot verify npm's current
# signing keys and fails to download pnpm.
RUN npm install --global "pnpm@$(node -p "require('./package.json').packageManager.split('@')[1]")" \
    && pnpm install --frozen-lockfile

COPY --from=vendor /var/www/html/vendor/tightenco/ziggy ./vendor/tightenco/ziggy
COPY resources ./resources
COPY public ./public
COPY vite.config.ts tailwind.config.js tsconfig.json ./
RUN pnpm build

# --- Application (php-fpm) -----------------------------------------------------------
FROM base AS app

COPY docker/php/prod.ini /usr/local/etc/php/conf.d/zz-prod.ini
COPY docker/php/entrypoint.prod.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

COPY --from=vendor /var/www/html/vendor ./vendor
COPY . .
COPY --from=assets /app/public/build ./public/build

# Writable directories are recreated here: .dockerignore keeps the host's runtime files out.
# Tests, local docs and CI files have no place in a production image.
RUN rm -rf tests docs .github \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && composer dump-autoload --no-dev --optimize --classmap-authoritative --no-interaction \
    && chown -R www-data:www-data storage bootstrap/cache

EXPOSE 9000

ENTRYPOINT ["entrypoint"]
CMD ["php-fpm"]

# --- Web (Caddy) -----------------------------------------------------------------------
FROM ${CADDY_IMAGE} AS web

COPY docker/caddy/Caddyfile /etc/caddy/Caddyfile
COPY --from=app /var/www/html/public /var/www/html/public

# --- All-in-one (Render and similar single-container hosts) ---------------------------
# php-fpm, Caddy (plain HTTP on $PORT: the platform terminates TLS) and the queue
# worker run together under supervisord. The database holds the queue, cache and
# sessions, so there is no Redis. Keep this the LAST stage.
FROM app AS render

COPY --from=web /usr/bin/caddy /usr/bin/caddy

# The official Caddy binary carries a file capability (cap_net_bind_service, to bind
# ports below 1024). Hosts that run containers without that capability refuse to
# execute such a file ("EPERM"). Caddy listens on $PORT (above 1024), so drop it, and
# fail the build if it is still there.
RUN apt-get update \
    && apt-get install -y --no-install-recommends supervisor libcap2-bin \
    && (setcap -r /usr/bin/caddy || true) \
    && test -z "$(getcap /usr/bin/caddy)" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY docker/render/Caddyfile /etc/caddy/Caddyfile
COPY docker/render/supervisord.conf /etc/supervisor/supervisord.conf
COPY docker/render/php-fpm.conf /usr/local/etc/php-fpm.d/zz-render.conf

ENV PORT=10000
EXPOSE 10000

# The inherited entrypoint builds the config/view caches, then runs this.
CMD ["supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
