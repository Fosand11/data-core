APP_NAME="Data Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=saas-db
DB_PORT=5432
DB_DATABASE=saas_core
DB_USERNAME=saas_app
DB_PASSWORD=local-only-change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=data_core

TENANCY_SEED_DEMO_DATA=true

# Use fake for deterministic local development, or gemini / openai for real generation.
DASHBOARD_AI_DRIVER=fake
DASHBOARD_AI_STALE_AFTER_MINUTES=10
DASHBOARD_AI_RATE_LIMIT_PER_MINUTE=3
DASHBOARD_AI_RATE_LIMIT_PER_HOUR=20
# Generations per day shared by all users (0 = no shared limit). Useful on a free tier.
DASHBOARD_AI_GLOBAL_PER_DAY=0
# Gemini (Google AI Studio key). Free-tier content may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=16384
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=240

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Docker Compose: local values only, never production credentials.
COMPOSE_PROJECT_NAME=data-core
APP_IMAGE_TAG=dev
WEB_PORT=8080
SAAS_DB_FORWARD_PORT=54320
REDIS_FORWARD_PORT=63790
METABASE_PORT=3000
METABASE_DB_FORWARD_PORT=54321
ANALYTICS_DB_FORWARD_PORT=54322

METABASE_DB_NAME=metabase_internal
METABASE_DB_USER=metabase_app
METABASE_DB_PASSWORD=local-only-change-me

ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics_app
ANALYTICS_DB_PASSWORD=local-only-change-me

# Explicit, configurable image versions. Do not replace these with latest.
PHP_IMAGE=php:8.4.11-fpm-bookworm
COMPOSER_IMAGE=composer:2.8.12
NGINX_IMAGE=nginx:1.28.0-alpine
POSTGRES_IMAGE=postgres:17.6-alpine
REDIS_IMAGE=redis:8.2.1-alpine
METABASE_IMAGE=metabase/metabase:v0.56.4

# Only used by compose.prod.yaml (production image build and HTTPS proxy).
NODE_IMAGE=node:22.12.0-bookworm-slim
CADDY_IMAGE=caddy:2.10.2-alpine
